# ==== Variablat e mjedisit për Vercel ====
# Kopjoni këtë skedar si .env për zhvillim lokal (opsionale) OSE
# vendosini në: Vercel → Project → Settings → Environment Variables

# Sekret për nënshkrimin e sesioneve (login). Vërini një varg të gjatë e të rastit.
# Gjeneroni një: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ndrysho-me-nje-varg-shume-te-gjate-dhe-te-rastit

# Vercel KV / Upstash Redis — shtohen VETËM kur lidhni bazën KV në Vercel.
# Nuk keni nevojë t'i mbushni vetë; Vercel i vendos automatikisht.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# (Opsionale) Emri i çelësit ku ruhet baza në KV. Parazgjedhje: datamanagment:db
# KV_DB_KEY=datamanagment:db
